# These are service locations, not branch database credentials.
DATACENTER_API_URL=http://192.168.0.27:4005
API_KEY=replace-with-upstream-api-key
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=3d
JWT_ISSUER=
JWT_AUDIENCE=
AUTH_MYSQL_HOST=
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_USER=
AUTH_MYSQL_PASSWORD=
AUTH_MYSQL_DATABASE=
AUTH_MYSQL_CONNECT_TIMEOUT_MS=5000
FRONTEND_ORIGIN=http://localhost:7071
NEXT_PUBLIC_API_URL=http://localhost:6060/api
PORT=6060
BRANCH_CACHE_TTL_MS=120000
DATACENTER_ACTIVE_VALUE=0
BRANCH_POOL_TTL_MS=120000
MSSQL_CONNECT_TIMEOUT_MS=5000
MSSQL_REQUEST_TIMEOUT_MS=15000

# Optional local diagnostic override. Credentials belong only in .env.
DIRECT_BRANCH_MODE=false
DIRECT_BRANCH_ID=
DIRECT_BRANCH_CODE=
DIRECT_BRANCH_LOCATION=
DIRECT_BRANCH_HOST=
DIRECT_BRANCH_PORT=1433
DIRECT_BRANCH_DATABASE=
DIRECT_BRANCH_USERNAME=
DIRECT_BRANCH_PASSWORD=
